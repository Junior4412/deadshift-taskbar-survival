{
  "name": "deadshift-taskbar",
  "version": "1.1.0",
  "description": "RPG idle de sobrevivência zumbi para a barra de tarefas",
  "author": "Junior4412",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js && node --check main.js && node --check preload.js && node --check src/game.js",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.deadshift.taskbar",
    "productName": "Deadshift: Taskbar Survival",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "src/**/*", "assets/**/*", "package.json"],
    "win": { "target": "portable", "artifactName": "Deadshift-Taskbar-Survival.exe" }
  }
}
